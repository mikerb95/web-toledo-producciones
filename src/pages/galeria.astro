---
// Galería completa con visor (src/scripts/galeria-visor.ts). La portada
// muestra solo las primeras 7 fotos y enlaza aquí.
import Pagina from '../layouts/Pagina.astro';
import Contacto from '../components/Contacto.astro';
import { getContent } from '../lib/content';
import { buildVM } from '../lib/viewmodel';
import { GALERIA } from '../data/galeria';

const content = await getContent();
const vmEs = buildVM(content, 'es');
const vmEn = buildVM(content, 'en');
const store = JSON.stringify({ es: vmEs, en: vmEn });
const vm = vmEs;
const t = vm.t;

const title = 'Galería de eventos: DJ, luces y sonido en Bogotá | Toledo Producciones';
const description = 'Fotos de producciones reales de Toledo Producciones en Bogotá: montajes de sonido, luces robóticas, láser y pistas llenas.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Galería de Toledo Producciones',
  url: new URL('/galeria', Astro.site).href,
  image: GALERIA.map((f) => ({ '@type': 'ImageObject', contentUrl: new URL(f.src, Astro.site).href, description: f.alt })),
};
---

<Pagina vm={vm} store={store} title={title} description={description} image={GALERIA[0].src} jsonLd={jsonLd}>
  <section style="position:relative;background:#08080a;padding:clamp(120px,15vw,150px) clamp(20px,5vw,48px) clamp(70px,9vw,110px)">
    <div style="max-width:1180px;margin:0 auto">
      <div style="max-width:640px;margin-bottom:40px">
        <div data-i18n="t.gal.kicker" style="font-size:12px;letter-spacing:2.5px;text-transform:uppercase;color:#E2C277;font-weight:600;margin-bottom:14px">{t.gal.kicker}</div>
        <h1 data-i18n="t.gal.title" style="font-family:var(--font-display);font-weight:700;font-size:clamp(34px,5.6vw,58px);line-height:1.02;letter-spacing:-1.2px;margin:0 0 16px;color:#F4EFE3">{t.gal.title}</h1>
        <p data-i18n="t.galp.sub" style="font-size:16px;line-height:1.6;color:#a09a8f;margin:0">{t.galp.sub}</p>
      </div>

      <div data-galeria class="galp-rejilla">
        {GALERIA.map((f, k) => (
          <button type="button" class:list={['galp-foto', { 'galp-alta': f.alta }]} data-foto={k} aria-haspopup="dialog">
            <img src={f.src} alt={f.alt} loading={k < 4 ? 'eager' : 'lazy'} decoding="async" />
          </button>
        ))}
        <div class="galp-barrido" data-barrido aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <Contacto vm={vm} />

  <dialog id="visor" class="visor" aria-label={t.gal.title}>
    <figure class="visor-marco">
      <img data-visor-img alt="" />
      <figcaption>
        <span data-visor-pie></span>
        <span data-visor-cuenta class="visor-cuenta"></span>
      </figcaption>
    </figure>
    <button type="button" class="visor-btn visor-cerrar" data-visor="cerrar" aria-label={t.galp.cerrar}>✕</button>
    <button type="button" class="visor-btn visor-ant" data-visor="ant" aria-label={t.galp.anterior}>←</button>
    <button type="button" class="visor-btn visor-sig" data-visor="sig" aria-label={t.galp.siguiente}>→</button>
  </dialog>

  <script>
    import '../scripts/galeria-visor';
    import '../scripts/contact-form';
    import { galeria } from '../scripts/motion/galeria';
    import { reducido } from '../scripts/motion/comun';
    if (!reducido()) galeria();
  </script>
</Pagina>

<style>
  .galp-rejilla {
    position: relative; display: grid; gap: 14px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    grid-auto-rows: 200px; grid-auto-flow: dense;
  }
  .galp-foto {
    position: relative; overflow: hidden; padding: 0; margin: 0; cursor: zoom-in;
    border-radius: 18px; border: 1px solid rgba(255,255,255,.07); background: #111013;
    transition: border-color .3s;
  }
  .galp-alta { grid-row: span 2; }
  .galp-foto img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform .8s cubic-bezier(.2,.7,.2,1);
  }
  .galp-foto:hover { border-color: rgba(226,168,46,.45); }
  .galp-foto:hover img { transform: scale(1.05); }
  .galp-foto:focus-visible { outline: 2px solid #E2A82E; outline-offset: 3px; }
  .galp-barrido {
    position: absolute; top: -4%; bottom: -4%; left: 0; width: 34%; pointer-events: none; opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(252,231,168,.28) 50%, transparent);
    mix-blend-mode: screen; transform: skewX(-12deg);
  }

  /* Visor: entra y sale con un fundido continuo (sin parpadeo). */
  .visor {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    background: rgba(6,6,8,.94); color: #ECE7DC;
    opacity: 0; transition: opacity .3s ease, overlay .3s allow-discrete, display .3s allow-discrete;
  }
  .visor[open] { opacity: 1; display: grid; place-items: center; }
  @starting-style { .visor[open] { opacity: 0; } }
  .visor::backdrop { background: transparent; }
  :global(html:has(.visor[open])) { overflow: hidden; }

  .visor-marco { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 64px clamp(12px,6vw,96px) 28px; max-width: 100%; }
  .visor-marco img { max-width: 100%; max-height: calc(100dvh - 150px); border-radius: 14px; object-fit: contain; box-shadow: 0 30px 90px rgba(0,0,0,.6); }
  .visor-marco figcaption { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 14px; font-size: 14px; color: #b6b0a4; text-align: center; }
  .visor-cuenta { color: #E2C277; font-weight: 700; font-variant-numeric: tabular-nums; }

  .visor-btn {
    position: absolute; width: 48px; height: 48px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(255,255,255,.07); border: 1px solid rgba(255,255,255,.16); color: #ECE7DC; font-size: 19px; cursor: pointer;
    transition: background-color .2s, border-color .2s;
  }
  .visor-btn:hover { background: rgba(226,168,46,.14); border-color: rgba(226,168,46,.5); }
  .visor-btn:focus-visible { outline: 2px solid #E2A82E; outline-offset: 2px; }
  .visor-cerrar { top: 16px; right: 16px; }
  .visor-ant { left: clamp(10px,2vw,28px); top: 50%; translate: 0 -50%; }
  .visor-sig { right: clamp(10px,2vw,28px); top: 50%; translate: 0 -50%; }
  @media (max-width: 640px) {
    .visor-ant, .visor-sig { top: auto; bottom: 18px; translate: none; }
    .visor-marco { padding-bottom: 84px; }
    .visor-marco img { max-height: calc(100dvh - 210px); }
  }
</style>
