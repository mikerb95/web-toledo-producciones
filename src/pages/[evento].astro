---
// Página por tipo de evento: /bodas, /quince-anos, /cumpleanos,
// /eventos-empresariales. Una sola plantilla; el texto está en
// src/data/eventos.ts y los paquetes, contacto y cobertura salen de la BD.
import { Image } from 'astro:assets';
import Pagina from '../layouts/Pagina.astro';
import Contacto from '../components/Contacto.astro';
import DemoServicio from '../components/DemoServicio.astro';
import { getContent } from '../lib/content';
import { buildVM, type ViewModel } from '../lib/viewmodel';
import { waLink } from '../lib/wa';
import { EVENTOS, preguntas, type EventoTexto } from '../data/eventos';
import { FOTOS_PAQUETE } from '../assets/packages/fotos';
import type { Lang } from '../i18n/strings';

const i = EVENTOS.findIndex((e) => e.slug === Astro.params.evento);
if (i < 0) return new Response(null, { status: 404 });
const ev = EVENTOS[i];

const content = await getContent();
const vmEs = buildVM(content, 'es');
const vmEn = buildVM(content, 'en');
const j = vmEs.packages.findIndex((p) => p.id === ev.paquete);
if (j < 0) return new Response(null, { status: 404 });

// Lo propio de esta página va en `pagina` dentro del view model de cada
// idioma, así el toggle lo resuelve con data-i18n="pagina...." como el resto.
const datos = (vm: ViewModel, lang: Lang, txt: EventoTexto) => {
  const p = vm.packages[j];
  const minimo = vm.packages.reduce((m, q) => (Number(q.price.replace(/\D/g, '')) < Number(m.price.replace(/\D/g, '')) ? q : m));
  return {
    ...txt,
    wa: waLink(vm.contact.whatsapp, txt.wa),
    faq: preguntas(lang, txt, p, minimo.price, vm.coverage),
  };
};
const pEs = datos(vmEs, 'es', ev.es);
const pEn = datos(vmEn, 'en', ev.en);
const store = JSON.stringify({ es: { ...vmEs, pagina: pEs }, en: { ...vmEn, pagina: pEn } });

const vm = vmEs;
const t = vm.t;
const pg = pEs;
const paq = vm.packages[j];
const nombre = vm.events[i]?.t ?? '';

const url = new URL(`/${ev.slug}`, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: ev.es.h1,
      description: ev.es.metaDesc,
      serviceType: 'Producción de eventos',
      url,
      areaServed: content.coverage.es.map((city) => ({ '@type': 'City', name: city })),
      provider: { '@type': 'EventPlanningService', name: 'Toledo Producciones', url: 'https://toledoproducciones.org' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: pEs.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://toledoproducciones.org/' },
        { '@type': 'ListItem', position: 2, name: nombre, item: url },
      ],
    },
  ],
};
---

<Pagina vm={vm} store={store} title={ev.es.metaTitle} description={ev.es.metaDesc} image={ev.fotos[0]} jsonLd={jsonLd}>
  <!-- Hero: foto del evento bajo su ambiente de luz. No usa el video de la
       portada porque trae un cartel con el logo que choca con el título. -->
  <section class="evp-hero" data-bucle>
    <img class="evp-fondo" src={ev.fotos[0]} alt="" fetchpriority="high" />
    <div class="evp-luz" aria-hidden="true" style={`background:${ev.ambiente}`}></div>
    <div class="evp-velo" aria-hidden="true"></div>
    <div style="position:relative;max-width:1180px;margin:0 auto;width:100%">
      <a href="/#eventos" class="back-link" style="display:inline-flex;align-items:center;gap:7px;color:#b6b0a4;font-size:13.5px;font-weight:600;margin-bottom:26px">
        <span aria-hidden="true">←</span> <span data-i18n="t.evp.back">{t.evp.back}</span>
      </a>
      <div style="display:flex;align-items:center;gap:9px;font-size:12px;letter-spacing:2.5px;text-transform:uppercase;color:#F4C752;font-weight:600;margin-bottom:16px">
        <span style="width:6px;height:6px;border-radius:50%;background:#F4C752;box-shadow:0 0 10px #F4C752"></span>
        <span data-i18n={`events.${i}.t`}>{nombre}</span>
      </div>
      <h1 data-i18n="pagina.h1" style="font-family:var(--font-display);font-weight:700;font-size:clamp(36px,6.4vw,68px);line-height:1.02;letter-spacing:-1.5px;margin:0 0 18px;color:#F7F2E6;max-width:820px">{pg.h1}</h1>
      <p data-i18n="pagina.sub" style="font-size:clamp(16px,2vw,19px);line-height:1.6;color:#cdc7bc;margin:0 0 32px;max-width:600px">{pg.sub}</p>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        <a href={pg.wa} target="_blank" rel="noopener" data-i18n-href="pagina.wa" class="gold-cta" data-magnetico style="display:inline-flex;align-items:center;gap:10px;background:linear-gradient(180deg,#F4C752,#D89A24);color:#1a1206;font-weight:700;font-size:15px;padding:15px 28px;border-radius:999px;box-shadow:0 12px 36px rgba(226,168,46,.32)">
          <span data-i18n="t.evp.cta">{t.evp.cta}</span> <span aria-hidden="true">→</span>
        </a>
        <a href="#recomendado" class="evp-cta2">
          <span data-i18n="t.evp.verPaquete">{t.evp.verPaquete}</span> <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Momentos -->
  <section class="checker-bg" style="padding:clamp(64px,9vw,110px) clamp(20px,5vw,48px);border-top:1px solid rgba(226,168,46,.1)">
    <div style="max-width:1180px;margin:0 auto">
      <h2 data-rev="up" data-i18n="t.evp.momentos" class="evp-h2">{t.evp.momentos}</h2>
      <ol style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:16px">
        {pg.momentos.map((m, k) => (
          <li data-rev="fade" class="evp-momento">
            <span aria-hidden="true" class="evp-num">{String(k + 1).padStart(2, '0')}</span>
            <h3 data-i18n={`pagina.momentos.${k}.t`} style="font-family:var(--font-display);font-weight:600;font-size:19px;margin:0 0 8px;color:#F4EFE3">{m.t}</h3>
            <p data-i18n={`pagina.momentos.${k}.d`} style="font-size:14.5px;line-height:1.6;color:#a09a8f;margin:0">{m.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Paquete recomendado -->
  <section id="recomendado" style="padding:clamp(64px,9vw,110px) clamp(20px,5vw,48px);scroll-margin-top:60px">
    <div style="max-width:1180px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:clamp(28px,5vw,56px);align-items:center">
      <div data-rev="up">
        <h2 data-i18n="t.evp.recomendado" class="evp-h2" style="margin-bottom:14px">{t.evp.recomendado}</h2>
        <p data-i18n="t.evp.recomendadoSub" style="font-size:16px;line-height:1.65;color:#a09a8f;margin:0 0 24px;max-width:440px">{t.evp.recomendadoSub}</p>
        <a href="/paquetes" class="back-link" style="display:inline-flex;align-items:center;gap:7px;color:#E2C277;font-size:14px;font-weight:700">
          <span data-i18n="t.evp.todos">{t.evp.todos}</span> <span aria-hidden="true">→</span>
        </a>
      </div>
      <a href={`/paquetes/${paq.id}`} data-rev="fade" class="evp-paquete" style={`--acento:${paq.accent}`}>
        <div style="position:relative;aspect-ratio:16/10;overflow:hidden">
          <Image src={FOTOS_PAQUETE[paq.id][0]} alt={paq.name} width={620} height={388} style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;view-transition-name:pkg-foto-${paq.id}`} />
          <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(10,9,7,.85))"></div>
        </div>
        <div style="padding:22px 24px 24px">
          <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 16px;margin-bottom:8px">
            <span data-i18n={`packages.${j}.name`} style="font-family:var(--font-display);font-weight:700;font-size:26px;color:#F4EFE3">{paq.name}</span>
            <span style="display:inline-flex;align-items:baseline;gap:7px">
              <span data-i18n={`packages.${j}.price`} style={`font-family:var(--font-display);font-weight:700;font-size:24px;color:${paq.accent}`}>{paq.price}</span>
              <span data-i18n={`packages.${j}.priceNote`} style="font-size:11.5px;color:#7d786f">{paq.priceNote}</span>
            </span>
          </div>
          <p data-i18n={`packages.${j}.tag`} style="font-size:14.5px;line-height:1.5;color:#a09a8f;margin:0 0 16px">{paq.tag}</p>
          <span class="evp-paquete-cta"><span data-i18n="t.pkg.cta">{t.pkg.cta}</span> <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <!-- Servicios que más aplican -->
  <section class="checker-bg" style="padding:clamp(64px,9vw,110px) clamp(20px,5vw,48px);border-top:1px solid rgba(226,168,46,.1)">
    <div style="max-width:1180px;margin:0 auto">
      <h2 data-rev="up" data-i18n="t.evp.servicios" class="evp-h2">{t.evp.servicios}</h2>
      <div data-luz data-bucle style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,248px),1fr));gap:16px">
        {ev.servicios.map((k) => (
          <div class="evp-serv" data-rev="fade">
            <DemoServicio i={k} />
            <h3 data-i18n={`t.serv.items.${k}.t`} style="font-family:var(--font-display);font-weight:600;font-size:18.5px;margin:0 0 9px;color:#F4EFE3">{t.serv.items[k].t}</h3>
            <p data-i18n={`t.serv.items.${k}.d`} style="font-size:14px;line-height:1.6;color:#9a948a;margin:0">{t.serv.items[k].d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Fotos -->
  <section style="padding:clamp(64px,9vw,110px) clamp(20px,5vw,48px) 0">
    <div style="max-width:1180px;margin:0 auto">
      <h2 data-rev="up" data-i18n="t.evp.fotos" class="evp-h2">{t.evp.fotos}</h2>
      <div data-rev="fade" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:14px">
        {ev.fotos.map((src) => (
          <div style="position:relative;aspect-ratio:4/3;border-radius:18px;overflow:hidden;border:1px solid rgba(255,255,255,.08)">
            <img src={src} alt="Evento producido por Toledo Producciones" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Preguntas frecuentes -->
  <section style="padding:clamp(64px,9vw,110px) clamp(20px,5vw,48px)">
    <div style="max-width:820px;margin:0 auto">
      <h2 data-rev="up" data-i18n="t.evp.faq" class="evp-h2">{t.evp.faq}</h2>
      <div data-rev="fade" style="display:flex;flex-direction:column;gap:10px">
        {pg.faq.map((f, k) => (
          <details class="evp-faq">
            <summary><span data-i18n={`pagina.faq.${k}.q`}>{f.q}</span><span class="evp-faq-signo" aria-hidden="true"></span></summary>
            <p data-i18n={`pagina.faq.${k}.a`}>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Contacto vm={vm} evento={i} />

  <script>
    import '../scripts/contact-form';
  </script>
</Pagina>

<style>
  .evp-hero {
    position: relative; overflow: hidden; display: flex; align-items: flex-end;
    min-height: min(86vh, 760px); padding: 130px clamp(20px,5vw,48px) clamp(56px,8vw,90px);
    background: #0a0a0c;
  }
  .evp-fondo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; animation: evp-acerca calc(var(--pulso) * 64) ease-in-out infinite alternate; }
  @keyframes evp-acerca { from { transform: scale(1); } to { transform: scale(1.07); } }
  .evp-luz { position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen; animation: evp-respira calc(var(--pulso) * 16) ease-in-out infinite; }
  @keyframes evp-respira { 0%, 100% { opacity: .75; } 50% { opacity: 1; } }
  .evp-velo {
    position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(180deg, rgba(8,8,10,.55) 0%, rgba(8,8,10,.2) 35%, rgba(8,8,10,.92) 100%),
      linear-gradient(90deg, rgba(8,8,10,.7) 0%, transparent 70%);
  }
  .evp-cta2 {
    display: inline-flex; align-items: center; gap: 9px; padding: 15px 24px; border-radius: 999px;
    border: 1px solid rgba(255,255,255,.22); background: rgba(8,8,10,.35); backdrop-filter: blur(6px);
    color: #ECE7DC; font-weight: 700; font-size: 15px; transition: border-color .2s, background-color .2s;
  }
  .evp-cta2:hover { border-color: rgba(226,168,46,.55); background: rgba(226,168,46,.08); }

  .evp-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(26px,4vw,40px); line-height: 1.06; letter-spacing: -1px; margin: 0 0 32px; color: #F4EFE3; }

  .evp-momento {
    padding: 24px 22px; border-radius: 18px;
    background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.012));
    border: 1px solid rgba(255,255,255,.08);
  }
  .evp-num { display: block; font-family: var(--font-display); font-weight: 700; font-size: 14px; letter-spacing: 1px; color: #E2A82E; margin-bottom: 14px; }

  .evp-paquete {
    display: block; overflow: hidden; border-radius: 22px;
    background: linear-gradient(180deg, rgba(255,255,255,.045), rgba(255,255,255,.012));
    border: 1px solid rgba(255,255,255,.1);
    transition: border-color .3s, transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .3s;
  }
  .evp-paquete:hover { border-color: rgba(226,168,46,.55); transform: translateY(-5px); box-shadow: 0 24px 60px rgba(0,0,0,.45); }
  .evp-paquete:focus-visible { outline: 2px solid #E2A82E; outline-offset: 3px; }
  .evp-paquete-cta {
    display: flex; align-items: center; justify-content: space-between; padding: 12px 16px; border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--acento) 35%, transparent); color: var(--acento); font-weight: 700; font-size: 14.5px;
    transition: background-color .2s;
  }
  .evp-paquete:hover .evp-paquete-cta { background: rgba(255,255,255,.04); }

  .evp-serv {
    background: linear-gradient(180deg, rgba(255,255,255,.035), rgba(255,255,255,.012));
    border: 1px solid rgba(255,255,255,.08); border-radius: 18px; padding: 26px 24px;
    transition: border-color .3s, transform .3s;
  }
  .evp-serv:hover { border-color: rgba(226,168,46,.45); transform: translateY(-4px); }

  .evp-faq { border: 1px solid rgba(255,255,255,.1); border-radius: 16px; background: rgba(255,255,255,.025); transition: border-color .25s, background-color .25s; }
  .evp-faq[open] { border-color: rgba(226,168,46,.35); background: rgba(226,168,46,.04); }
  .evp-faq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none;
    padding: 18px 20px; font-family: var(--font-display); font-weight: 600; font-size: 16.5px; color: #F4EFE3;
  }
  .evp-faq summary::-webkit-details-marker { display: none; }
  .evp-faq summary:focus-visible { outline: 2px solid #E2A82E; outline-offset: 2px; border-radius: 16px; }
  .evp-faq-signo { position: relative; flex-shrink: 0; width: 14px; height: 14px; }
  .evp-faq-signo::before, .evp-faq-signo::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; border-radius: 2px; background: #E2A82E; transition: transform .3s cubic-bezier(.2,.7,.2,1); }
  .evp-faq-signo::after { transform: rotate(90deg); }
  .evp-faq[open] .evp-faq-signo::after { transform: rotate(0deg); }
  .evp-faq p { margin: 0; padding: 0 20px 20px; font-size: 15px; line-height: 1.65; color: #a8a293; }
</style>
