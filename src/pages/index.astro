---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Paquetes from '../components/Paquetes.astro';
import Dron from '../components/Dron.astro';
import Eventos from '../components/Eventos.astro';
import Galeria from '../components/Galeria.astro';
import Cobertura from '../components/Cobertura.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { getContent } from '../lib/content';
import { buildVM } from '../lib/viewmodel';

// SSR: el contenido se lee de la BD en cada request, así las ediciones del
// admin se reflejan para todos. Render inicial en ES; el toggle cliente
// intercambia a EN usando el store embebido.
const content = await getContent();
const vmEs = buildVM(content, 'es');
const vmEn = buildVM(content, 'en');
const store = JSON.stringify({ es: vmEs, en: vmEn });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EventPlanningService',
  name: 'Toledo Producciones',
  description:
    'Producción de eventos en Bogotá: DJ, sonido, iluminación, show láser, luces robóticas, cubrimiento 4K y cubrimiento en dron.',
  url: 'https://toledoproducciones.org',
  telephone: `+${content.contact.whatsapp}`,
  email: content.contact.email,
  image: 'https://toledoproducciones.org/og-image.jpg',
  areaServed: content.coverage.es.map((city) => ({ '@type': 'City', name: city })),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bogotá',
    addressCountry: 'CO',
  },
  sameAs: [`https://www.instagram.com/${content.contact.instagram}`],
};
---

<Base>
  <div style="position:relative;min-height:100vh;background:#08080a;overflow:hidden">
    <Nav vm={vmEs} />
    <Hero vm={vmEs} />
    <Servicios vm={vmEs} />
    <Paquetes vm={vmEs} />
    <Dron vm={vmEs} />
    <Eventos vm={vmEs} />
    <Galeria vm={vmEs} />
    <Cobertura vm={vmEs} />
    <Contacto vm={vmEs} />
    <Footer vm={vmEs} />
  </div>

  <script id="toledo-data" type="application/json" set:html={store} is:inline></script>

  <script>
    import '../scripts/lang-toggle';
    import '../scripts/package-modal';
    import '../scripts/contact-form';
    import '../scripts/reveal';
  </script>
</Base>
