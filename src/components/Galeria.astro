---
import type { ViewModel } from '../lib/viewmodel';
import { GALERIA } from '../data/galeria';
interface Props { vm: ViewModel; }
const { vm } = Astro.props;
// 7 slots; 1 y 5 ocupan dos filas (igual que el prototipo).
const spans = [2, 1, 1, 1, 2, 1, 1];
const photos = GALERIA.slice(0, spans.length);
---
<section id="galeria" style="position:relative;background:#08080a;padding:clamp(70px,9vw,120px) clamp(20px,5vw,48px)">
  <div style="max-width:1180px;margin:0 auto">
    <div data-rev="up" style="max-width:640px;margin-bottom:44px">
      <div data-i18n="t.gal.kicker" style="font-size:12px;letter-spacing:2.5px;text-transform:uppercase;color:#E2C277;font-weight:600;margin-bottom:14px">{vm.t.gal.kicker}</div>
      <h2 data-i18n="t.gal.title" style="font-family:var(--font-display);font-weight:700;font-size:clamp(28px,4.4vw,46px);line-height:1.04;letter-spacing:-1px;margin:0 0 14px;color:#F4EFE3">{vm.t.gal.title}</h2>
      <p data-i18n="t.gal.sub" style="font-size:15.5px;line-height:1.6;color:#a09a8f;margin:0">{vm.t.gal.sub}</p>
    </div>
    <div data-rev="fade" data-galeria style="position:relative;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));grid-auto-rows:190px;gap:14px">
      {spans.map((span, i) => (
        <div class="gal-foto" style={`grid-row:span ${span};border-radius:18px;overflow:hidden;position:relative;border:1px solid rgba(255,255,255,.07)`}>
          <img src={photos[i].src} alt={photos[i].alt} loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
        </div>
      ))}
      <div class="gal-barrido" data-barrido aria-hidden="true"></div>
    </div>
    <div data-rev="up" style="margin-top:28px;display:flex;justify-content:center">
      <a href="/galeria" class="gal-todas">
        <span data-i18n="t.gal.all">{vm.t.gal.all}</span>
        <span class="gal-todas-n">{GALERIA.length}</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .gal-foto img { transition: transform .8s cubic-bezier(.2,.7,.2,1); }
  .gal-foto:hover img { transform: scale(1.05); }
  .gal-todas {
    display: inline-flex; align-items: center; gap: 10px; padding: 13px 22px; border-radius: 999px;
    border: 1px solid rgba(226,168,46,.35); color: #E2C277; font-weight: 700; font-size: 14.5px;
    transition: background-color .2s, border-color .2s, gap .25s;
  }
  .gal-todas:hover { background: rgba(226,168,46,.08); border-color: rgba(226,168,46,.6); gap: 13px; }
  .gal-todas-n { font-size: 12px; color: #1a1206; background: #E2C277; border-radius: 999px; padding: 2px 8px; }
  /* Haz que cruza la rejilla al entrar (galeria.ts). Sin JS no se ve. */
  .gal-barrido {
    position: absolute; top: -8%; bottom: -8%; left: 0; width: 34%; pointer-events: none; opacity: 0;
    background: linear-gradient(90deg, transparent, rgba(252,231,168,.28) 50%, transparent);
    mix-blend-mode: screen; transform: skewX(-12deg);
  }
</style>
