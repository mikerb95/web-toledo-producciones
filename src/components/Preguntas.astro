---
// Preguntas frecuentes en acordeón (<details>). Los textos se cambian de
// idioma con data-i18n: `i18n` es la ruta del array en el store
// (p. ej. "pagina.faq"), con el mismo largo en ES y EN.
interface Props {
  titulo: string;
  tituloI18n: string;
  items: { q: string; a: string }[];
  i18n: string;
}
const { titulo, tituloI18n, items, i18n } = Astro.props;
---
<section style="padding:clamp(64px,9vw,110px) clamp(20px,5vw,48px)">
  <div style="max-width:820px;margin:0 auto">
    <h2 data-rev="up" data-i18n={tituloI18n} style="font-family:var(--font-display);font-weight:700;font-size:clamp(26px,4vw,40px);line-height:1.06;letter-spacing:-1px;margin:0 0 32px;color:#F4EFE3">{titulo}</h2>
    <div data-rev="fade" style="display:flex;flex-direction:column;gap:10px">
      {items.map((f, k) => (
        <details class="faq">
          <summary><span data-i18n={`${i18n}.${k}.q`}>{f.q}</span><span class="faq-signo" aria-hidden="true"></span></summary>
          <p data-i18n={`${i18n}.${k}.a`}>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { border: 1px solid rgba(255,255,255,.1); border-radius: 16px; background: rgba(255,255,255,.025); transition: border-color .25s, background-color .25s; }
  .faq[open] { border-color: rgba(226,168,46,.35); background: rgba(226,168,46,.04); }
  .faq summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; cursor: pointer; list-style: none;
    padding: 18px 20px; font-family: var(--font-display); font-weight: 600; font-size: 16.5px; color: #F4EFE3;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary:focus-visible { outline: 2px solid #E2A82E; outline-offset: 2px; border-radius: 16px; }
  .faq-signo { position: relative; flex-shrink: 0; width: 14px; height: 14px; }
  .faq-signo::before, .faq-signo::after { content: ''; position: absolute; left: 0; top: 6px; width: 14px; height: 2px; border-radius: 2px; background: #E2A82E; transition: transform .3s cubic-bezier(.2,.7,.2,1); }
  .faq-signo::after { transform: rotate(90deg); }
  .faq[open] .faq-signo::after { transform: rotate(0deg); }
  .faq p { margin: 0; padding: 0 20px 20px; font-size: 15px; line-height: 1.65; color: #a8a293; }
</style>
