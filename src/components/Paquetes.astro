---
import { Image } from 'astro:assets';
import type { ViewModel } from '../lib/viewmodel';
import { FOTOS_PAQUETE as PHOTOS } from '../assets/packages/fotos';
interface Props { vm: ViewModel; }
const { vm } = Astro.props;
---
<section id="paquetes" class="checker-bg" style="position:relative;padding:clamp(70px,9vw,120px) clamp(20px,5vw,48px);border-top:1px solid rgba(226,168,46,.1);border-bottom:1px solid rgba(226,168,46,.1)">
  <div style="max-width:1180px;margin:0 auto">
    <div data-rev="up" style="text-align:center;max-width:640px;margin:0 auto 56px">
      <div data-i18n="t.pkg.kicker" style="font-size:12px;letter-spacing:2.5px;text-transform:uppercase;color:#E2C277;font-weight:600;margin-bottom:14px">{vm.t.pkg.kicker}</div>
      <h2 data-i18n="t.pkg.title" style="font-family:var(--font-display);font-weight:700;font-size:clamp(28px,4.4vw,46px);line-height:1.04;letter-spacing:-1px;margin:0 0 16px;color:#F4EFE3">{vm.t.pkg.title}</h2>
      <p data-i18n="t.pkg.sub" style="font-size:16px;line-height:1.6;color:#a09a8f;margin:0">{vm.t.pkg.sub}</p>
    </div>
    <div data-luz data-bucle style="display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:18px;align-items:stretch">
      {vm.packages.map((p, i) => (
        <a href={`/paquetes/${p.id}`} class:list={["pkg-card", { "pkg-popular": p.popular }]} data-rev="fade" style={`transition:transform .35s cubic-bezier(.2,.7,.2,1),border-color .3s,box-shadow .3s;position:relative;display:flex;flex-direction:column;background:linear-gradient(180deg,rgba(255,255,255,.045),rgba(255,255,255,.012));border:1px solid rgba(255,255,255,.1);border-radius:22px;padding:0 0 30px;overflow:hidden;color:inherit`}>
          <div style="position:relative;width:100%;aspect-ratio:16/10;overflow:hidden">
            <Image src={PHOTOS[p.id][0]} alt={p.name} width={580} height={363} style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;view-transition-name:pkg-foto-${p.id}`} />
            <div style="position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(10,9,7,.85))"></div>
            {p.popular && <div class="pkg-seguidor" aria-hidden="true"></div>}
          </div>
          <div style="padding:22px 26px 0;display:flex;flex-direction:column;flex:1">
          {p.popular && (
            <div data-i18n="t.pkg.popular" data-i18n-prefix="★ " style={`position:absolute;top:18px;right:18px;background:linear-gradient(180deg,#F4C752,#D89A24);color:#1a1206;font-weight:700;font-size:11px;letter-spacing:.5px;padding:6px 12px;border-radius:999px;box-shadow:0 6px 18px rgba(226,168,46,.35)`}>★ {vm.t.pkg.popular}</div>
          )}
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
            <div style={`font-family:var(--font-display);font-weight:700;font-size:13px;color:${p.accent};border:1px solid ${p.accent}66;border-radius:999px;width:30px;height:30px;display:flex;align-items:center;justify-content:center`}>{p.num}</div>
            <div data-i18n={`packages.${i}.name`} style="font-family:var(--font-display);font-weight:600;font-size:24px;color:#F4EFE3">{p.name}</div>
          </div>
          <div style={`height:3px;border-radius:3px;width:54px;background:linear-gradient(90deg,${p.accent},rgba(255,255,255,0));margin-bottom:20px`}></div>
          <p data-i18n={`packages.${i}.tag`} style="font-size:14.5px;line-height:1.55;color:#a09a8f;margin:0 0 22px;min-height:44px">{p.tag}</p>
          {p.drone && (
            <div data-i18n="t.pkg.droneTag" data-i18n-prefix="◆ " style={`display:inline-flex;align-items:center;gap:7px;background:${p.accent}1a;border:1px solid ${p.accent}66;color:${p.accent};font-weight:700;font-size:11.5px;letter-spacing:.5px;padding:6px 12px;border-radius:999px;margin-bottom:16px;width:fit-content`}>◆ {vm.t.pkg.droneTag}</div>
          )}
          <div style="display:flex;align-items:baseline;gap:8px;margin-bottom:22px">
            <div data-i18n={`packages.${i}.price`} style={`font-family:var(--font-display);font-weight:700;font-size:clamp(30px,4vw,40px);line-height:1;color:${p.accent}`}>{p.price}</div>
            <div data-i18n={`packages.${i}.priceNote`} style="font-size:12px;color:#7d786f;font-weight:500">{p.priceNote}</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:11px;flex:1">
            {p.preview.map((f, fi) => (
              <div style="display:flex;align-items:flex-start;gap:10px;font-size:13.5px;line-height:1.45;color:#cdc7bc">
                <span style="color:#E2A82E;font-size:13px;margin-top:1px">✦</span><span data-i18n={`packages.${i}.preview.${fi}`}>{f}</span>
              </div>
            ))}
            {p.hasExtra && (
              <div data-i18n={`packages.${i}.extra`} style="font-size:13px;color:#7d786f;font-weight:600;padding-left:23px">{p.extra}</div>
            )}
          </div>
          <span class="pkg-cta" style={`margin-top:22px;width:100%;display:flex;align-items:center;justify-content:space-between;gap:10px;background:transparent;border:1px solid ${p.accent}55;color:${p.accent};font-weight:700;font-size:14.5px;padding:13px 18px;border-radius:12px;transition:background .2s,border-color .2s`}><span data-i18n="t.pkg.cta">{vm.t.pkg.cta}</span> <span aria-hidden="true" style="font-size:17px">→</span></span>
          </div>
        </a>
      ))}
    </div>
    <div data-rev="up" style="margin-top:44px;border:1px solid rgba(255,255,255,.1);border-radius:22px;padding:28px 30px;background:linear-gradient(180deg,rgba(255,255,255,.03),rgba(255,255,255,.008))">
      <div data-i18n="additionalServices.title" style="font-family:var(--font-display);font-weight:600;font-size:15px;letter-spacing:1px;text-transform:uppercase;color:#E2C277;margin-bottom:18px">{vm.additionalServices.title}</div>
      <div style="display:flex;flex-wrap:wrap;gap:12px">
        {vm.additionalServices.items.map((item, ai) => (
          <div style="display:flex;align-items:center;gap:9px;font-size:14px;color:#cdc7bc;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:999px;padding:9px 16px">
            <span style="color:#E2A82E;font-size:13px">✦</span><span data-i18n={`additionalServices.items.${ai}`}>{item}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* El seguidor (follow spot) descansa sobre el paquete más elegido: un cono
     de luz cálida que respira cada dos compases sobre la foto. */
  .pkg-popular { border-color: rgba(226,168,46,.38) !important; }
  .pkg-seguidor {
    position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen;
    background:
      radial-gradient(60% 75% at 50% 112%, rgba(252,231,168,.30), transparent 70%),
      linear-gradient(180deg, transparent 0%, rgba(244,199,82,.10) 100%);
    clip-path: polygon(44% 0, 56% 0, 92% 100%, 8% 100%);
    animation: pkg-respira calc(var(--pulso) * 8) ease-in-out infinite;
  }
  @keyframes pkg-respira { 0%, 100% { opacity: .65; } 50% { opacity: 1; } }
  .pkg-card:hover { border-color: rgba(226,168,46,.55); transform: translateY(-6px); box-shadow: 0 24px 60px rgba(0,0,0,.45); }
  .pkg-card:hover .pkg-cta { background: rgba(255,255,255,.04); }
  .pkg-card:focus-visible { outline: 2px solid #E2A82E; outline-offset: 3px; }
</style>
