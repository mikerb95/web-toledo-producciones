---
import type { ViewModel } from '../lib/viewmodel';
interface Props { vm: ViewModel; }
const { vm } = Astro.props;
const c = vm.contact;
---
<footer class="checker-bg" style="position:relative;border-top:1px solid rgba(226,168,46,.16);padding:56px clamp(20px,5vw,48px) calc(clamp(16px,3vw,28px) + 80px);background-size:48px 48px;background-position:0 0,24px 24px">
  <div style="max-width:1180px;margin:0 auto;display:flex;flex-wrap:wrap;gap:36px;justify-content:space-between;align-items:flex-start">
    <div style="max-width:340px">
      <div style="display:flex;align-items:flex-end;gap:9px;margin-bottom:14px">
        <span class="gold-text" style="font-family:var(--font-display);font-weight:700;font-size:26px;letter-spacing:-.5px">Toledo</span>
        <span style="font-size:10px;letter-spacing:4px;font-weight:600;color:#9a948a;padding-bottom:4px">PRODUCCIONES</span>
      </div>
      <p data-i18n="t.footer.tagline" style="color:#8b867c;font-size:14px;line-height:1.6;margin:0">{vm.t.footer.tagline}</p>
    </div>
    <div style="display:flex;gap:clamp(28px,6vw,72px);flex-wrap:wrap">
      <div>
        <div data-i18n="t.footer.contact" style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#E2C277;font-weight:600;margin-bottom:14px">{vm.t.footer.contact}</div>
        <div style="display:flex;flex-direction:column;gap:10px;font-size:14px;color:#c4beb3">
          <a href={vm.links.tel} class="foot-link">{c.phone}</a>
          <a href={vm.links.mail} class="foot-link">{c.email}</a>
          <a href={vm.links.ig} target="_blank" rel="noopener" class="foot-link">@{c.instagram}</a>
        </div>
      </div>
      <div>
        <div data-i18n="t.footer.zone" style="font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#E2C277;font-weight:600;margin-bottom:14px">{vm.t.footer.zone}</div>
        <div data-i18n="coverageCity" style="font-size:14px;color:#c4beb3;max-width:220px;line-height:1.6">{vm.coverageCity}</div>
      </div>
    </div>
  </div>
  <div style="max-width:1180px;margin:38px auto 0;padding-top:22px;border-top:1px solid rgba(255,255,255,.07);display:flex;flex-wrap:wrap;gap:12px;justify-content:space-between;align-items:center;color:#6f6a61;font-size:12.5px">
    <span>© 2026 Toledo Producciones · Bogotá, Colombia</span>
    <span data-i18n="t.footer.slogan">{vm.t.footer.slogan}</span>
    <a href="https://codebymike.net" target="_blank" rel="noopener" class="cbm" aria-label="codebymike.net">
      <span class="cbm-mark" aria-hidden="true">&lt;/&gt;</span>
      <span class="cbm-copy">
        <span class="cbm-label" data-i18n="t.footer.credit">{vm.t.footer.credit}</span>
        <span class="cbm-name">codebymike<span class="cbm-tld">.net</span></span>
      </span>
      <svg class="cbm-arrow" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M5 11L11 5M6 5h5v5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</footer>

<style>
  .foot-link:hover { color: #fff; }
  /* Firma del desarrollador: monograma + nombre con barrido dorado al pasar. */
  .cbm {
    display: inline-flex; align-items: center; gap: 11px;
    padding: 7px 14px 7px 7px; border-radius: 999px;
    border: 1px solid rgba(226,168,46,.14);
    background: linear-gradient(180deg, rgba(255,255,255,.025), rgba(255,255,255,0));
    color: var(--muted-2); text-decoration: none;
    transition: border-color .35s, background-color .35s, box-shadow .35s;
  }
  .cbm-mark {
    display: grid; place-items: center; width: 30px; height: 30px; border-radius: 50%;
    font: 600 10.5px/1 ui-monospace, 'SFMono-Regular', Menlo, monospace; letter-spacing: -.5px;
    color: #0b0a08;
    background: linear-gradient(135deg, var(--gold-1), var(--gold-3) 55%, var(--gold-4));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.45), 0 0 0 3px rgba(226,168,46,.08);
    transition: transform .5s cubic-bezier(.2,.8,.2,1), box-shadow .35s;
  }
  .cbm-copy { display: flex; flex-direction: column; gap: 3px; line-height: 1; }
  .cbm-label { font-size: 9.5px; letter-spacing: 2.2px; text-transform: uppercase; color: var(--muted-4); }
  .cbm-name {
    font-family: var(--font-display); font-weight: 600; font-size: 14.5px; letter-spacing: -.2px;
    background: linear-gradient(90deg, var(--text) 0%, var(--text) 40%, var(--gold-1) 50%, var(--gold-2) 60%, var(--text) 70%, var(--text) 100%);
    background-size: 250% 100%; background-position: 100% 0;
    -webkit-background-clip: text; background-clip: text; color: transparent;
    transition: background-position .9s cubic-bezier(.2,.8,.2,1);
  }
  .cbm-tld { color: var(--gold-chip); -webkit-text-fill-color: var(--gold-chip); font-weight: 500; }
  .cbm-arrow { color: var(--muted-3); transition: transform .35s cubic-bezier(.2,.8,.2,1), color .35s; }

  .cbm:hover, .cbm:focus-visible {
    border-color: rgba(226,168,46,.38);
    background-color: rgba(226,168,46,.05);
    box-shadow: 0 10px 30px -14px rgba(226,168,46,.45);
  }
  .cbm:focus-visible { outline: 2px solid var(--gold-2); outline-offset: 3px; }
  .cbm:hover .cbm-mark, .cbm:focus-visible .cbm-mark { transform: rotate(-12deg) scale(1.06); box-shadow: inset 0 1px 0 rgba(255,255,255,.45), 0 0 0 4px rgba(226,168,46,.16); }
  .cbm:hover .cbm-name, .cbm:focus-visible .cbm-name { background-position: 0 0; }
  .cbm:hover .cbm-arrow, .cbm:focus-visible .cbm-arrow { color: var(--gold-2); transform: translate(2px,-2px); }

  @media (prefers-reduced-motion: reduce) {
    .cbm, .cbm-mark, .cbm-name, .cbm-arrow { transition: none; }
  }
</style>
